{# Extend page template #}
{% extends 'templates/page_wrap.twig' %}

{% set title = is_trade_account ? global.theme.settings.text_trade_application : 'Opret din konto' %}
{% set breadcrumb_title = is_trade_account ? 'Ansøg om en forhandlerkonto.' : 'Opret din konto.' %}
{% set hideTitle = 1 %}
{% set hideDesc = 1 %}


{% block page_content %}
    <div class="text-center">
        <h1>
            Tilmeld
        </h1>
        <h4 class="subheader" data-name="{{ is_trade_account ? 'text_trade_application' : '' }}">
            {{ title }}
        </h4>
    </div>
    {{ theme.errors(errors) }}
    <div class="row">
        <div class="column medium-push-1 medium-10 large-push-2 large-8">
            <form class="form-with-validation account-create clearblock" action="{{ global.current_url }}" method="post">
                {% if (global.theme.settings.company_name_field and not is_trade_account) or is_trade_account %}
                    <label class="field-block">
                        <span class="field-label">Virksomhed</span>
                        {{ html.input('company', form_field_value('firstname', global.customer.company), 'required') }}
                    </label>
                {% endif %}
                <div class="row">
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Fornavn</span>
                            {{ html.input('firstname', form_field_value('firstname', global.customer.first_name), 'required') }}
                        </label>
                    </div>
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Efternavn</span>
                            {{ html.input('lastname', form_field_value('lastname', global.customer.last_name), 'form-control required') }}
                        </label>
                    </div>
                </div>
                {% if (global.theme.settings.date_of_birth_field and not is_trade_account) or (global.theme.settings.trade_date_of_birth_field and is_trade_account) %}
                    <div class="row">
                        <div class="large-6 column">
                            <label class="field-block">
                                <span class="field-label">Fødselsdag</span>
                                {{ html.input('date_of_birth', form_field_value('date_of_birth', global.customer.date_of_birth), 'form-control', '', '', 'readonly') }}
                            </label>
                        </div>
                    </div>
                {% endif %}
                <div class="row">
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Email adresse</span>
                            {{ html.input('email', form_field_value('email', global.customer.email), 'required', '','email', 'autocomplete="off"') }}
                        </label>
                    </div>
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Telefonnummer</span>
                            {{ html.input('phone', form_field_value('phone', global.customer.phone), '') }}
                        </label>
                    </div>
                </div>
                {% if global.theme.settings.trade_mobile_number_field and is_trade_account %}
                    <div class="row">
                        <div class="large-6 column">
                            <label class="field-block">
                                <span class="field-label">Mobilnummer</span>
                                {{ html.input('mobile', form_field_value('mobile', global.customer.mobile), 'jsv_digits') }}
                            </label>
                        </div>
                    </div>
                {% endif %}
                <div class="row">
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Password</span>
                            <input type="password" name="password" id="password1" value="" placeholder="" required>
                        </label>
                    </div>
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Bekræft password</span>
                            <input type="password" name="password_confirm" value="" placeholder="" required>
                        </label>
                    </div>
                </div>
                <h3>
                    Adresse
                </h3>
                <div class="row">
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Adresselinje 1</span>
                            {{ html.input('address_line1', form_field_value('address_line1', global.customer.address_line1), '') }}
                        </label>
                    </div>
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Adresselinje 2</span>
                            {{ html.input('address_line2', form_field_value('address_line2', global.customer.address_line2), '') }}
                        </label>
                    </div>
                </div>
                <div class="row">
                    <div class="column">
                        <label class="field-block">
                            <span class="field-label">By</span>
                            {{ html.input('city', form_field_value('city', global.customer.city), '') }}
                        </label>
                    </div>
                </div>
                <div class="row">
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Postnummer</span>
                            {{ html.input('zip', form_field_value('zip', global.customer.zip), '') }}
                        </label>
                    </div>
                    <div class="large-6 column">
                        <label class="field-block">
                            <span class="field-label">Land</span>
                            {{ html.select('country_id', countries, form_field_value('country_id', global.customer.country_id|default(222)), 'form-control medium custom-select', 'Select...') }}
                        </label>
                    </div>
                </div>
                {% if is_trade_account %}
                    <div class="row">
                        {% if global.theme.settings.trade_company_website_field %}
                            <div class="large-6 column">
                                <label class="field-block">
                                    <span class="field-label">Website</span>
                                    {{ html.input('website', form_field_value('website', global.customer.website), '') }}
                                </label>
                            </div>
                        {% endif %}
                        {% if global.theme.settings.trade_vat_number_field %}
                            <div class="large-6 column">
                                <label class="field-block">
                                    <span class="field-label">CVR nummer</span>
                                    {{ html.input('vat_number', form_field_value('vat_number', global.customer.vat_number), 'required') }}
                                </label>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="row">
                    <div class="column large-8 large-push-2">
                        {% if customer_sources|length %}
                            <label class="field-block">
                                <span class="field-label">Hvordan har du hørt om os?</span>
                                {{ html.select('source', customer_sources, form_field_value('source'), 'form-control medium custom-select', 'Select...') }}
                            </label>
                        {% endif %}
                        <div class="field--newsletter margin-bottom">
                            <input id="newsletter" type="checkbox" name="marketing" value="0" class="mod--1">
                            <label for="newsletter">Vil du modtage vores nyhedsbrev?</label>
                        </div>
                        <input type="text" name="{{ global.honeypot_field_name }}" class="hide" autocomplete="off">
                        {% if recaptcha %}
                            <div class="g-recaptcha margin-bottom"></div>
                        {% endif %}
                        {% set button_text = is_trade_account ? gts.button_create_trade_account : gts.button_create_account %}
                        {% set button_setting = is_trade_account ? 'button_create_trade_account' : 'button_create_account' %}
                        <button type="submit" class="button expanded" data-name="{{ button_setting }}">{{ button_text }}</button>
                        <p class="text-center">
                            Har du allerede en konto? <a class="link--emphasis" href="/account/login">Log ind</a>
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if global.theme.settings.date_of_birth_field or global.theme.settings.trade_date_of_birth_field %}
        <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    {% endif %}
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {% if global.theme.settings.date_of_birth_field or global.theme.settings.trade_date_of_birth_field %}
        {{ html.script('//cdn.jsdelivr.net/npm/jquery-ui-dist@1.12.1/jquery-ui.js') }}
        <script>
            // call picker
            $('[name="date_of_birth"]').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                yearRange: "1900:+0",
                maxDate: '0'
            }).autocomplete({
                disabled: true
            });
        </script>
    {% endif %}
{% endblock %}