{# Extend page template #}
{% extends 'templates/page.twig' %}

{% set title = 'Forgotten Your Password?' %}
{% set breadcrumb_title = 'Forgotten Password' %}
{% set hideTitle = 1 %}
{% set hideDesc = 1 %}

{% block page_content %}
    <div class="text-center">
        <h1>
           {{ title }}
        </h1>
        <h4 class="subheader">
            Get a new one here.
        </h4>
    </div>
    <div class="row clearblock">
        <div class="column medium-push-2 medium-8 large-push-3 large-6">
            {{ theme.form({ 'email_address': { 'name': 'email', 'required': true } }, errors, { 'email_address': 'Email Address' }, 'Request Password', '', 'expanded') }}
        </div>
    </div>
{% endblock %}
