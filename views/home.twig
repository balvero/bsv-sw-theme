{% block bannerCarousel %}

    {% set fullWidth = 1 %}
    {% set home_galleries = {
        'large': gts.gallery_home_banner,
        'small': gts.gallery_home_banner_mobile
    } %}

    {# Render carousel #}
    {% for size, gallery in home_galleries %}
        {% if gallery %}
            <div class="home-carousel-outer home-carousel{{ size == 'small' ? '-mobile hide-for-banner-large' : '-desktop show-for-banner-large' }}">
                <div id="js-home-carousel{{ size == 'small' ? '-mobile' : '' }}"
                     class="carousel home-carousel {{ fullWidth ? '' : 'row column' }}"
                     data-autoplay="{{ gts.gallery_autoplay ? true : false }}"
                     data-speed="{{ gts.gallery_autoplaySpeed * 1000 }}"
                >
                    {% for image in gallery %}
                        <div class="home-carousel-slide">
                            {% if image.target_url %}
                                <a href="{{ image.target_url }}">
                                    <img src="{{ image.url }}" alt="{{ image.name }}" class="full-width">
                                </a>
                            {% else %}
                                <img src="{{ image.url }}" alt="{{ image.name }}" class="full-width">
                            {% endif %}
                            {% if image.name %}
                                {% set formatted = image.name|split('|') %}
                                <div class="home-carousel-overlay{{ size == 'small' ? '-mobile' : '' }}">
                                    {{ size == 'large' ? '<div class="inner">' }}
                                        {% if formatted|length %}
                                            {% if formatted[0]|length %}
                                                <h2>
                                                    {{ formatted[0] }}
                                                </h2>
                                            {% endif %}
									 		{% if formatted[2]|length %}
                                                <div class="banner-text">
                                                    {{ formatted[1] }}
                                                </div>
                                            {% endif %}
                                            {% if formatted[2]|length and image.target_url %}
                                                <a href="{{ image.target_url }}" class="button">
                                                   {{ formatted[2] }}
                                                </a>
												<div class="spacer"></div>
                                            {% endif %}
                                        {% else %}
                                            {{ image.name|raw }}
                                        {% endif %}
                                    {{ size == 'large' ? '</div>' }}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}


{% block imagesCarousel %}

    {% set fullWidth = 0 %}
    {% set home_galleries = {
        'large': gts.gallery_home,
        'small': gts.gallery_home_mobile
    } %}

    {# Render carousel #}
    {% for size, gallery in home_galleries %}
        {% if gallery %}
	<section  class="testimonials {{loop.index == 2 ? 'second'}}">
			

				<div class="home-carousel-outer no-padding home-carousel{{ size == 'small' ? '-mobile hide-for-banner-large' : '-desktop show-for-banner-large' }}">
					<div id="js-home-carousel{{ size == 'small' ? '-mobile' : '' }}"
						 class="testimonials-slider {{ fullWidth ? '' : 'row fullWidth' }}"

					>
						{% for image in gallery %}
							<div class="home-carousel-slide">
								{% if image.target_url %}
									<a href="{{ image.target_url }}">
										<img src="{{ image.url }}" alt="{{ image.name }}" class="full-width">
									</a>
								{% else %}
									<img src="{{ image.url }}" alt="{{ image.name }}" class="full-width">
								{% endif %}
								{% if image.name %}
									{% set formatted = image.name|split('|') %}
									<div class="testimonial-overlay">
									   <div class="inner">
											{% if formatted|length %}
												{% if formatted[0]|length %}
													<p>"
														{{ formatted[0] }}
														"
													</p>
												{% endif %}
												{% if formatted[1]|length %}

													 <p class="name">
														- {{ formatted[1] }}
													</p>

												{% endif %}
											{% else %}
												{{ image.name|raw }}
											{% endif %}
										</div>
									</div>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				</div>
		
	</section>
        {% endif %}
    {% endfor %}
{% endblock %}


{% block featuredCategories %}
    {# Render featured categories #}
    {% if featured_categories|length %}
        <section class="featured-categories-home">
            <div class="display-box inner ">
                {% if gts.text_featured_categories_title %}
               		<div class="row column">
				        <h2 class="featured-categories-title section-heading ">
                       Find den rette løsning til din opgave	
                    	</h2>
					</div>
                {% endif %}
                <div class="category-slider row ">
                    {% for category in featured_categories %}
                        <div class="cat-box-slide column large-2{{ loop.index == 1 ? ' first' : '' }}">
                            <a href="{{ category.url }}?all" class="image-container">
                                <img src="{{ category.photo_url }}" alt="{{ category.photo_description }}">
                            </a>
                            <a class="box-data" href="{{ category.url }}?all">
                                <h3>
                                    {{ category.title }}
                                </h3>
                                {% if category.description2 %}
                                    <p class="box-description">
                                        {{ category.description2|striptags }}
                                    </p>
                                {% endif %}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}


{% block campaignSection %}
    <section class="promo-section margin-bottom padding-bottom padding-top margin-top">
        <div class="row column">
            <div class="row display-flex align-items-center column" >
                <div class="column large-6 campaign-image" >
                    <div class="image-container-home"> 
							<img src="{{gts.gallery_home_snippet[0].url}}" 
							 alt="Maskiner Under Broen 2026 Campaign" 
							 style="width: 100%; height: auto; display: block;">
					</div>
                </div>
                <div class="column large-6" data-equalizer-watch>
					{% if gts.text_welcome_h3 %}
                    <div class="section-subheading">
                        {{ gts.text_welcome_h3 }}
                    </div>
					{% endif %}
					{% if gts.text_welcome_h1 %}
					 <h2 class="section-heading">
                       {{ gts.text_welcome_h1 }}
                    </h2>
					{% else %}
                    <h2 class="section-heading">
                       60 år med danskproduceret løfteudstyr
                    </h2>
					{% endif %}
                    <div class="section-text">
						{% if gts.text_welcome_p %}
							{{ gts.text_welcome_p|raw }}
						{% else %}
                       <p>
						   BSV har siden 1960 produceret løfteudstyr og krantilbehør til industri, byggeri og energisektoren.
						</p>
						<p>
							Vores produktion foregår i Danmark, og vi har kontrol over hele processen – fra udvikling til test og levering. Det sikrer høj kvalitet og korte leveringstider.
							Vi tilbyder et bredt udvalg af udstyr til kraner, lastbiler, minigravere og tårnkraner.
							Blandt vores kerneprodukter finder du hydrauliske grabbe, mekaniske tænger, pallegafler og originale reservedele.
							
						</p>
						<p>BSV samarbejder nu med den tyske løftegrejs producent <img src="https://files.ecommercedns.uk/266351/ab63c412decc8d8f5ffda0f4b679aaf7.jpg" style="max-width: 100px;"></p>
					{% endif %}
                    </div>
					<div class="cta margin-bottom">
						<a href="{{ gts.campaign_section_link }}" class="button">{{ gts.campaign_section_link_text }}</a>
					</div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}


{% block companySection%}
    <section class="company-section padding-bottom bg-shade padding-top margin-top">
        <div class="row column">
            <div class="row display-flex align-items-center column">
				  <div class="column large-6">
					  {% if gts.company_section_subtitle %}
           			   <div class="section-subheading">
                        	{{ gts.company_section_subtitle }}
                    	</div>
					  {% endif %}
					  {% if gts.company_section_title %}
					  
					   <h2 class="section-heading">{{gts.company_section_title }}</h2>
					  
					  {% else %}
					  	<h2 class="section-heading">
                        Løftegrej der fungerer – også i praksis

						</h2>
                   
					  {% endif %}
                    <div class="section-text">
						{% if gts.company_section_text %}
							{{ gts.company_section_text|raw }}
						{% else %}
                        <p>
							Hos BSV får du mere end bare standardudstyr – du får gennemprøvede løsninger, udviklet til virkelige behov og krav i industrien:
						</p>
						<p>
							<ul>
								<li><strong>Høj driftssikkerhed:</strong> Vores produkter er bygget til lang levetid og lavt vedligehold</li>

								<li><strong>Certificeret kvalitet</strong> Alt udstyr testes og leveres med dokumentation</li>

								<li><strong>Fokus på sikkerhed:</strong> Beskytter medarbejderne og minimerer skader</li>

								<li><strong>Dansk produktion:</strong> Hurtig levering og fleksible tilpasninger</li>

								<li><strong>Erfaring og sparring:</strong> Over 60 års branchekendskab giver dig en stærk samarbejdspartner</li>
							</ul>
						</p>
					  {% endif %}
                    </div>
                </div>
                <div class="column large-6">
					
					{% if gts.company_section_video_url %}
					<div class="video-block"><video width="" height="" playsinline="" muted="" autoplay="" loop="" >
						<source src="{{ gts.company_section_video_url }}" type="video/mp4">
						  Your browser does not support the video tag.
						</video>
					</div>
					{% else %}
                    <div class="image-container-home">
                        {% for image in gts.gallery_company_snippet %}
                            {% if loop.index == 1 %}
                                <img src="{{ image.url }}" alt="{{ image.name }}">
                            {% endif %}
                        {% endfor %}
                    </div>
					{% endif %}
                </div>
              
            </div>
        </div>
    </section>

{% endblock%}

{% block videoSection %}

    <section class="sw-section sw-section-video bg-shade" >
            <div class="row column narrow" style="max-width: 720px;">
                <div class="inner">
                    <div class="responsive-embed">
						{{ gts.video_section_embed_code |raw}}
                    </div>
                </div>
				<div class="row column text-center margin-top padding-top margin-bottom">
					 <h2 class="section-heading">
						{{ gts.video_section_title }}
					</h2>
					<div class="section-text">
						{{ gts.video_section_text }}
					</div>
				</div>
            </div>
		</section>
{% endblock%}


{% block featuredProducts %}
    {# Render featured categories #}
    {% if featured_products|length %}
        <section class="featured-products inner-section section-block bg-shade last">
            <div class="row column">
                <h2 class="featured-products-title section-title">
                    What's hot
                </h2>
                {% include 'partials/items.twig' with {
                    'items': featured_products,
                    'item_type': 'product',
                    'classes': 'product-slider',
                    rangeSlider: true
                } %}
            </div>
        </section>
    {% endif %}
{% endblock %}


{% block recentlyViewed %}
    {% if global.recently_viewed_products|length %}
        <section class="recent-products section-block">
            <div class="row column">
                <h2 class="section-title">
                    Recently viewed
                </h2>
            </div>
            <div class="row small-up-2 medium-up-4 large-up-5">
                {% for product in global.recently_viewed_products|slice(0, 5) %}
                    <div class="column">
                        <div class="recent-box card item-box item-image">
                            <a class="image-container" href="{{ product.url }}" data-fit="0">
                                <img src="{{ product.photo_url }}">
                            </a>
                            {% if product.in_wishlist %}
                                <a href="/wishlist?action=remove&amp;product_id={{ product.id }}" class="button no-margin secondary wishlist-button">
                                    <span class="show-for-sr">{{ gts.button_remove_from_wishlist }}</span>
                                    <i class="sw-icon-star-on" aria-hidden="true"></i>
                                </a>
                            {% else %}
                                <a href="/wishlist?action=add&amp;product_id={{ product.id }}" class="button no-margin secondary wishlist-button">
                                    <span class="show-for-sr">{{ gts.button_add_to_wishlist }}</span>
                                    <i class="sw-icon-star" aria-hidden="true"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}


{% block instagramFeed %}
    {% if gts.instagram_token|length %}
        <section class="section-block">
            <h2 class="text-center">
                Instagram Feed
            </h2>
            <div class="row column">
                <ul class="ig_images no-bullet row small-up-2 medium-up-4 large-up-6"></ul>
            </div>
        </section>
    {% endif %}
{% endblock %}


{% block scripts %}
    {{ parent() }}
    {% if gts.instagram_token|length %}
        {{ html.script(asset_url('js/instagram.js')) }}
        <script>
            $('.ig_images').instagram({
                accessToken: '{{ gts.instagram_token }}',
                urls: true
            });
        </script>
    {% endif %}
{% endblock %}

