{% extends 'templates/blocks.twig' %}

{% block content %}
    <footer>
        <div class="footer-top">
            <div class="row">
                <div class="show-for-large large-7 column">
                    {% set fcats = featured_categories(5) %}
                    {% if fcats|length %}
                        <ul class="menu">
                            {# Render featured category links #}
                            {% for category in fcats %}
                                <li>
                                    <a href="{{ category.url }}">{{ category.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <div class="large-5 column large-text-right">
                    {{ block('footer_social') }}
                </div>
            </div>
        </div>
        <div class="footer-middle">
            <div class="row">
                <div class="large-8 column">
                    <div class="row">
                        <div class="large-4 column">
                            {{ theme.link_list('footer', 'footer-middle-menu menu vertical', 0) }}
                        </div>
                        <div class="large-4 column">
                            {{ theme.link_list('footer_middle', 'footer-middle-menu menu vertical', 0) }}
                        </div>
                        <div class="large-4 column">
                            {{ theme.link_list('footer_right', 'footer-middle-menu menu vertical', 0) }}
                        </div>
                    </div>
                </div>
                <div class="large-4 column end">
                    {{ block('footer_payment') }}
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="row">
                <div class="large-6 column">
                    {{ block('footer_copyright') }}
                </div>
            </div>
            <div class="footer-right">
                <div class="row">
                    <div class="footer-subscribe large-6 large-push-6 column">
                        <div class="inner">
                            {{ block('footer_newsletter') }}
                        </div>
                    </div>
                    <div class="large-6 large-pull-6 column large-text-right">
                        <span class="footer-attribution">
                            <a href="{{ global.service_provider.website_url }}" target="_blank">Ecommerce Websites</a> by {{ global.service_provider.name }}
                        </span>
                    </div>

                </div>
            </div>
        </div>
    </footer>
{% endblock %}


{% block footer_social %}
    <ul class="footer-social menu simple">
        {% if global.theme.settings.social_tiktok %}
			<li>
				<a href="{{ global.theme.settings.social_tiktok }}" target="_blank">
					{{ theme.social_icon('tiktok') }}
				</a>
			</li>
		{% endif %}
        {% if global.theme.settings.social_facebook %}
			<li>
				<a href="{{ global.theme.settings.social_facebook }}" target="_blank">
					{{ theme.social_icon('facebook-new') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_twitter %}
			<li>
				<a href="{{ global.theme.settings.social_twitter }}" target="_blank">
					{{ theme.social_icon('x-new') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_pinterest %}
			<li>
				<a href="{{ global.theme.settings.social_pinterest }}" target="_blank">
					{{ theme.social_icon('pinterest-new') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_youtube %}
			<li>
				<a href="{{ global.theme.settings.social_youtube }}" target="_blank">
					{{ theme.social_icon('youtube-new') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_instagram %}
			<li>
				<a href="{{ global.theme.settings.social_instagram }}" target="_blank">
					{{ theme.social_icon('instagram-new') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_snapchat %}
			<li>
				<a href="{{ global.theme.settings.social_snapchat }}" target="_blank">
					{{ theme.social_icon('snapchat') }}
				</a>
			</li>
		{% endif %}
        {% if global.theme.settings.social_whatsapp %}
            {% set show_whatsapp = true %}
            {% if global.theme.settings.social_whatsapp_mobile and not global.visitor.is_mobile %}
                {% set show_whatsapp = false %}
            {% endif %}
            {% if show_whatsapp %}
                <li>
                    <a href="https://wa.me/{{ global.theme.settings.social_whatsapp }}" target="_blank">
                        {{ theme.social_icon('whatsapp') }}
                    </a>
                </li>
            {% endif %}
        {% endif %}
		{% if global.theme.settings.social_tumblr %}
			<li>
				<a href="{{ global.theme.settings.social_tumblr }}" target="_blank">
					{{ theme.social_icon('tumblr-new') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_ebay %}
			<li>
				<a href="{{ global.theme.settings.social_ebay }}" target="_blank">
					{{ theme.social_icon('ebay') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_etsy %}
			<li>
				<a href="{{ global.theme.settings.social_etsy }}" target="_blank">
					{{ theme.social_icon('etsy') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_amazon %}
			<li>
				<a href="{{ global.theme.settings.social_amazon }}" target="_blank">
					{{ theme.social_icon('amazon') }}
				</a>
			</li>
		{% endif %}
		{% if global.theme.settings.social_linkedin %}
			<li>
				<a href="{{ global.theme.settings.social_linkedin }}" target="_blank">
					{{ theme.social_icon('linkedin-new') }}
				</a>
			</li>
		{% endif %}
    </ul>
{% endblock %}


{% block footer_copyright %}
    {# Render copyright statement #}
    <div class="footer-copy">
        <div class="inner">
            <p>{{ theme.text_snippet('copyright') }}</p>
            {% if global.business.address %}
                <address>{{ global.business.one_line_address }}</address>
            {% endif %}
        </div>
    </div>
{% endblock %}


{% block footer_newsletter %}
    {# Render newsletter form #}
    {% if global.theme.settings.mailchimp_action %}
        <form action="{{ global.theme.settings.mailchimp_action }}" method="post" class="newsletter-form form-with-validation" name="mc-embedded-subscribe-form" target="_blank" novalidate="novalidate">
            <div class="input-group">
                <span class="input-group-label">
                    {{ theme.sw_icon('speech') }}
                </span>
                {{ html.input('EMAIL', '', 'input-group-field jsv_email required', 'enter your email address for our newsletter...') }}
                <div class="input-group-button">
                    {{ html.button('', '', '', 'button', true, 'submit', 'right-arrow') }}
                </div>
            </div>
        </form>
    {% else %}
        <form action="/newsletter-subscribe" method="post" class="newsletter-form form-with-validation">
            <div class="input-group">
                <span class="input-group-label">
                    {{ theme.sw_icon('speech') }}
                </span>
                {{ html.input('email', '', 'input-group-field jsv_email required', 'enter your email address for our newsletter...') }}
                <div class="input-group-button">
                    {{ html.button('', '', '', 'button', true, 'submit', 'right-arrow') }}
                </div>
            </div>
        </form>
    {% endif %}
{% endblock %}


{% block footer_payment %}
    <div class="footer-payment">
        <h4 class="footer-payment-heading show-for-large">
            Ways you can pay
        </h4>
        {% include 'partials/payment_icons.twig' with { 'classes' : 'footer-payment-list' } %}
    </div>
{% endblock %}
