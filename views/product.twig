{# Extend page template #}
{% extends 'templates/page.twig' %}

{% set breadcrumb_title = product.title|default('Product Not Found') %}
{% set full_width = 1 %}

{% block breadcrumbs %}
	{# Add breadcrumbs #}
	{% for breadcrumb in breadcrumbs %}
		<li>
			<a href="{{ breadcrumb.url }}">
				{{ breadcrumb.name }}
			</a>
		</li>
	{% endfor %}
{% endblock %}

{% block footer %}
    {{ parent() }}
    {{ theme.info_message(errors) }}
    {{ theme.info_message(review_errors) }}
{% endblock %}

{% block page_content %}
	{% if product %}
		{# Render errors #}
        <div class="row column">
    		{{ theme.errors(errors) }}
    		{{ theme.errors(review_errors) }}
        </div>
        {# Render product #}
        {% include 'partials/product_form.twig' %}

        {{ block('product_related') }}
        {{ block('product_bundle') }}
	{% else %}
		<h1>
			{{ breadcrumb_title }}
		</h1>
	{% endif %}
{% endblock %}


{% block product_images %}
    <div class="product-image">
        <div class="row">
            <div class="column">
                <div role="region" aria-label="Product Images" class="product-main-image">
                    {# Render photo box #}
                    {% if product.photo_url %}
                        <a class="image-container product-gallery-main-photo"
                           data-fit="{{ gts.image_container_product ? '1' : '0' }}"
                           data-zoom="{{ gts.product_zoom }}"
                           {% if gts.product_lightbox %}
                           data-fancybox="gallery"
                           data-src="{{ product.photo_url }}"
                           {% endif %}
                        >
                            <img src="{{ product.photo_url }}" class="product-gallery-photo" alt="{{ product.photo_description }}">
                        </a>
                    {% endif %}
                </div>
                {% if gts.product_zoom %}
                    <div class="image-utils show-for-medium text-center row column">
                        <div class="image-utils-item">
                            {{ theme.sw_icon('plus-zoom') }}
                            <small>Hover over the image to zoom</small>
                        </div>
                    </div>
                {% endif %}
            </div>
            {% if product.photos|length  %}
                <div class="column hide">
                    {# Render photos #}
                    <div id="product-carousel" class="product-thumbs carousel">
                        {% for photo in product.photos %}
                            <div class="product-thumbs-slide slide">
                                <a href="{{ photo.url }}" class="js-item-image p{{ loop.index0 }} image-container {{ loop.first ? 'active' : '' }}"{% if gts.product_lightbox and not loop.first %} data-fancybox="gallery" data-src="{{ photo.url }}"{% endif %}>
                                    <img src="{{ photo.url }}" alt="{{ photo.description }}">
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
        {% if product.photos|length > 1 %}
            <div class="text-center">
                <button class="gallery-toggle js-show-gallery">
                    View gallery
                </button>
            </div>
        {% endif %}
    </div>
{% endblock %}


{% block product_info %}
    <div class="product-info">
        {# brand name #}
        {% if product.brand.title %}
            <p class="product-brand">
                <a href="{{ product.brand.url }}" target="_blank">{{ product.brand.title }}</a>
            </p>
        {% endif %}
        {# product name #}
        <h1 class="unweight">
            {{ product.title }}
        </h1>
        {% if global.features.apps.product_reviews %}
            {# product reviews and form #}
            <div id="productReview" class="product-reviews shader-box hide" data-toggler=".hide">
                <a class="product-reviews-close" data-toggle="productReview productDescription product-form reviewToggleIn">
                    Close reviews
                </a>
                <br>
                {# Render reviews #}
                <ul class="product-reviews-list menu simple">
                    {% for review in product.reviews %}
                        <li class="product-reviews-list-item">
                            <div class="review-author">
                                <strong>{{ review.name }}</strong>
                            </div>
                            <div class="review-comment">
                                <p>
                                    {{ review.content }}
                                </p>
                            </div>
                            <div class="review-raiting">
                                {% for i in 1..5 %}
                                    {% set starClass = ( review.rating >= i ? 'on' : 'off' ) %}
                                    <span class="{{ starClass }}" data-review="{{ product.rating }}">
                                        {{ theme.sw_icon('heart-o', 'raiting heart') }}
                                    </span>
                                {% endfor %}
                            </div>
                        </li>
                    {% else %}
                        <li>
                            <p>There are no reviews for this product.</p>
                        </li>
                    {% endfor %}
                </ul>
                {# form #}
                <div>
                    <h3>Leave a review</h3>
                    {# Render review form #}
                    {{ theme.form(review_form_fields, false, { 'name': 'Name', 'content': 'Review', 'rating': 'Rating' }, '', '', 'expanded margin-none') }}
                </div>
            </div>
        {% endif %}
        {# description #}
        {% if product.description|length %}
            <div class="product-description unweight fr-view" id="productDescription" data-toggler=".hide">
                {{ product.description|raw }}
            </div>
        {% endif %}
        {{ block('product_tabs') }}
        <div class="info-details margin-bottom">
            {% if product.raw_video_embed_code %}
                <a data-fancybox href="{{ product.video_embed_code }}">
                    {{ theme.sw_icon('play') }}
                    <span>View video</span>
                </a>
            {% endif %}
            <div class="info-reward{{ product.reward_points ? '' : ' hide' }}">
                <span class="number-badge" id="product-reward-points">{{ product.reward_points }}</span>
                <span>Reward points</span>
            </div>
            <div class="info-code{{ product.sku ? '' : ' hide' }}">
                <span>SKU</span>
                <span id="product-sku">{{ product.sku }}</span>
            </div>
        </div>
    </div>
{% endblock %}

{% block product_form %}
    {# Minimum and maximum order quantities #}
    {% set order_min = not global.features.extensions.min_max_quantity ? 0 : global.minimum_product_quantity > 0 ? global.minimum_product_quantity : product.minimum_order_quantity %}
    {% set order_max = not global.features.extensions.min_max_quantity ? 0 : global.maximum_product_quantity > 0 ? global.maximum_product_quantity : product.maximum_order_quantity %}

    {# Render product form #}
    <form id="product-form"
          data-toggler=".hide"
          action="{{ product.url }}"
          method="post"
          data-min-quantity="{{ order_min }}"
          data-max-quantity="{{ order_max }}"
          {% if product.user_files > 0 %} enctype="multipart/form-data"{% endif %}
    >
        {# Render options #}
        {% if product.options|length %}
            <div class="row">
                <div class="columns large-12">
                    {% for option in product.options %}
                        {% if gts.variant_buttons %}
                            <div class="product-option margin-bottom">
                                <input type="hidden" name="value[]" value="" class="product-option-value">
                                <label>
                                    Select Your {{ option.name }}
                                </label>
                                <div class="product-option-container">
                                    {% set group = loop.index0 %}
                                    {% for value in option.values %}
                                        {% if not value.hidden %}
                                            {% set parts = value.name|split(':#') %}
                                            {% set name = parts[0] %}
                                            {% set color = parts[1] ? parts[1] : '' %}
                                            <label class="rectangle {{ color ? 'color top' : '' }}"{% if color %} data-tooltip title="{{ name }}"{% endif %}>
                                                <input type="radio" name="group{{ group }}" value="{{ value.id }}" class="product-option-input">
                                                <span class="inner" style="{{ color ? ('background-color:#' ~ color ~ ';') : '' }}">
                                                    {{ name }}
                                                </span>
                                            </label>
                                        {% endif %}
                                    {% else %}
                                        <div class="note">
                                            Choose an option from the list above...
                                        </div>
                                        <input type="radio" name="group{{ group }}" value="" class="product-option-input" checked="checked">
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <label>
                                <span class="field-label show-for-sr">{{ option.name }}</span>
                                <select name="value[]" class="product-option simple">
                                    <option value="">{{ option.name }}</option>
                                    {% for value in option.values %}
                                        <option value="{{ value.id }}">
                                            {{ value.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </label>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        {% if product.alt_options|length %}
            <div class="row">
                <div class="columns large-12">
                    {% for option in product.alt_options %}
                        <label>
                            <span class="field-label show-for-sr">{{ option.name }}</span>
                            <select name="alt2_attribute_id[]" class="simple">
                                <option value="">{{ option.name }}</option>
                                {% for value in option.values %}
                                    <option value="{{ value.id }}" data-price="{{ value.price ? value.price|number_format(2) : 0 }}">
                                        {{ value.name }}
                                        {% if value.price and display_price %}
                                            + {{ format_price(value.price) }}
                                        {% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        {# Render extras #}
        {% if product.extras|length %}
            <div class="row">
                <div class="columns large-12">
                    <fieldset class="info-extra" data-total="0">
                        <ul class="no-bullet">
                            {% for extra in product.extras %}
                                {% set data_price = extra.price|number_format(2) %}
                                <li>
                                    {{ html.input('product_extras[]', extra.id, 'mod', '', 'checkbox', 'id="extra-' ~ extra.id ~ '" data-price="' ~ data_price ~ '"') }}
                                    <label for="extra-{{ extra.id }}">
                                        {{ extra.name }}
                                        {% if extra.price and display_price %}
                                            <strong>+ {{ format_price(extra.price) }}</strong>
                                        {% endif %}
                                    </label>
                                </li>
                            {% endfor %}
                        </ul>
                    </fieldset>
                </div>
            </div>
        {% endif %}
        {% if product.user_files > 0 or product.customization_fields|length %}
            {# Render customization fields #}
            {% for field in product.customization_fields %}
                <label>
                    <span class="field-label show-for-sr">{{ field.label }}</span>
                    {% if field.type == 1 %}
                        {{ html.input('customization_field[' ~ field.id ~ ']', '', 'simple', field.label, 'text', field.max_length ? 'maxlength="' ~ field.max_length ~ '"' : '') }}
                    {% elseif field.type == 2 %}
                        {{ html.textarea('customization_field[' ~ field.id ~ ']', '', 'simple', field.label, '2') }}
                    {% endif %}
                </label>
            {% endfor %}
            {# Render file fields #}
            {% if product.user_files > 0 %}
                <label class="field-label">Please upload your file{{ product.user_files > 1 ? 's' : '' }}</label>
                {% for i in 1..product.user_files %}
                    {{ html.input('files[]', '', '', '', 'file') }}
                {% endfor %}
            {% endif %}
            <hr>
        {% endif %}
        {% if display_price %}
            <div class="product-cost">
                <div id="product-sale-price" class="price">
                    {{ format_price(product.sale_price) }}
                </div>
                <div id="product-price" class="price">
                    {{ format_price(product.price) }}
                </div>
                {% if product.rrp %}
                    <div class="product-rrp float-right">
                        <span>RRP</span>
                        <span id="product-rrp">
                            {{ format_price(product.rrp) }}
                        </span>
                    </div>
                {% endif %}
            </div>
        {% else %}
            {% include 'partials/hidden_prices.twig' %}
        {% endif %}
        <hr>
        <div class="product-buy">
            <div class="buy-upper row padding-bottom" data-equalizer>
                {% if gts.product_quantity_box %}
                    <div class="column small-4" data-equalizer-watch>
                        <div class="product-qty input-group">
                            <span class="input-group-label">Qty:</span>
                            {{ html.input('quantity', '1', 'quantity-input input-group-field text-center') }}
                        </div>
                    </div>
                {% else %}
                    <input type="hidden" name="quantity" value="1">
                {% endif %}
                <div class="column small-{{ gts.product_quantity_box ? '8' : '12' }} text-right" data-equalizer-watch>
                    {# Render wishlist buttons #}
                    {% if product.in_wishlist %}
                        <a href="/wishlist?action=remove&amp;product_id={{ product.id }}" class="button--simple product-wishlist">
                            {{ theme.sw_icon('heart') }}
                            <span>{{ gts.button_remove_from_wishlist }}</span>
                        </a>
                    {% else %}
                        <a href="/wishlist?action=add&amp;product_id={{ product.id }}" class="button--simple product-wishlist">
                            {{ theme.sw_icon('heart-o') }}
                            <span>{{ gts.button_add_to_wishlist }}</span>
                        </a>
                    {% endif %}
                </div>
            </div>
            {% set softClass = soft_add_button ? 'product-soft-add-button' : '' %}
            {# Render add to basket button #}
            {{ html.button('cart_button', '', gts.button_add_to_basket, 'button expanded button_add-basket product-add-button ' ~ softClass,'','','','data-nostock="' ~ gts.button_out_of_stock ~ '" data-text="' ~ gts.button_add_to_basket ~ '"') }}
        </div>
        {% if (order_min or order_max) and global.features.extensions.min_max_quantity %}
            <p class="order-quantity">
                {% if order_min %}
                    A <strong>minimum order quantity of {{ order_min }}</strong>
                    {% if order_max %}
                        and a <strong>maximum of {{ order_max }}</strong>
                    {% endif %}
                {% elseif order_max %}
                    A <strong>maximum order quantity of {{ order_max }}</strong>
                {% endif %} applies.
            </p>
        {% endif %}
        {# review form toggle #}
        <div class="row">
            {% if global.features.apps.product_reviews %}
                <div class="small-5 column">
                    <p>
                        <a data-toggle="productReview productDescription product-form" class="inline-link review-toggle--in underline" id="reviewToggleIn">
                            View / leave a review
                        </a>
                    </p>
                </div>
            {% endif %}
            <div class="small-{{ global.features.apps.product_reviews ? '7' : '12 '}} column text-right product-indicators">
                {# Render labels #}
                {% if product.two_for_one %}
                    <div class="label primary two-for-one"><span>2</span> For <span>1</span></div>
                {% endif %}
                {% if product.three_for_two %}
                    <div class="label primary three-for-two"><span>3</span> For <span>2</span></div>
                {% endif %}
                {% if product.new %}
                    <div class="label secondary new">New</div>
                {% endif %}
            </div>
        </div>
        {{ block('product_share') }}
        {{ block('send_to_friend') }}
        {% if global.features.extensions.back_in_stock %}
            <div class="stock-requests-container shader-box">
                <p>
                    <strong>This item is currently out of stock.</strong>
                    We’ll notify you when it’s back in stock if you enter your email address in the box below..
                </p>
                <input type="text" name="stock_request_name" placeholder="Your Name">
                <input type="text" name="stock_request_email" placeholder="Your Email Address">
                <button class="button tertiary expanded margin-none" name="stock_request" value="1" type="submit">Notify me</button>
            </div>
        {% endif %}
    </form>
{% endblock %}


{% block product_bundles %}
    {% if product.bundles|length %}
        <hr>
        <div class="product-bundles">
            {% for bundle in product.bundles %}
                <div class="bundle-product">
                    <div class="row">
                        <div class="column small-3">
                            <a href="{{ bundle.url }}" class="image-container">
                                <img src="{{ bundle.photo_url }}" alt="{{ bundle.title }}">
                            </a>
                        </div>
                        <div class="column small-9">
                            <h3 class="bundle-product-heading">
                                {{ bundle.title }}
                            </h3>
                            {% if display_price %}
                                <div class="price">{{ currency_value(bundle.price) }}</div>
                            {% else %}
                                {% include 'partials/hidden_prices.twig' %}
                            {% endif %}
                            <a href="{{ bundle.url }}">Find out more</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <hr>
    {% endif %}
{% endblock %}


{% block product_bulk_pricing %}
    {% if gts.bulk_discount_tables and (product.bulk_prices or product.bulk_variations) and display_price %}
        <p class="margin-top">
            <strong>Bulk Buy Discounts</strong> save money buy buying in bulk
        </p>
        {% if product.bulk_prices|length %}
            <table class="bulk-discounts-table">
                <tr>
                    <th>Quantity Purchased</th>
                    <th>Price</th>
                </tr>
                {% for bulk_price in product.bulk_prices %}
                    <tr>
                        <td>{{ bulk_price.quantity }}</td>
                        <td>{{ currency_value(bulk_price.value) }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
        {% if product.bulk_variations|length %}
            <table class="bulk-discounts-table-vars">
                <tr>
                    <th>Variation</th>
                    <th>Quantity Purchased</th>
                    <th>Price</th>
                </tr>
                {% for variation in product.bulk_variations %}
                    {% for price in variation.prices %}
                        <tr>
                            <td>{{ variation.title }}</td>
                            <td>{{ price.quantity }}</td>
                            <td>{{ currency_value(price.value) }}</td>
                        </tr>
                    {% endfor %}
                {% endfor %}
            </table>
        {% endif %}
    {% endif %}
{% endblock %}


{% block send_to_friend %}
    {% if global.features.extensions.send_to_a_friend %}
        <div class="product-recommend">
            <a data-open="recommendModal" class="product-recommend-button">
                {{ theme.sw_icon('send') }}
                <span>Send to a friend</span>
            </a>
        </div>
        <div class="reveal" id="recommendModal" data-reveal>
            <p class="reveal-heading">
                Recommend to a friend
            </p>
            <form action="{{ global.current_url }}" method="post">
                <label class="field-block">
                    <span class="field-label">Email address</span>
                    <input type="email" name="email_address">
                </label>
                <label class="field-block">
                    <span class="field-label">Message</span>
                    <textarea cols="30" rows="5" name="message"></textarea>
                </label>
                <input type="text" name="{{ global.honeypot_field_name }}" autocomplete="off" class="hide">

                {% if recommendation_recaptcha %}
                    <div class="g-recaptcha"></div>
                    <br>
                {% endif %}
                <input type="hidden" name="redirect_message" value="The email has been sent">
                <div class="text-center">
                    <button name="send_recommendation_email" value="1" class="button padded-y">
                        Send message
                    </button>
                </div>
            </form>
            <button class="close-button" data-close aria-label="Close modal" type="button">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endif %}
{% endblock %}


{% block product_share %}
    {% if global.theme.settings.show_product_social_buttons %}
        {{ theme.share_buttons(global.current_url, product.title, product.description, product.photo_url, true, 'social-menu menu simple') }}
    {% endif %}
{% endblock %}


{% block product_tabs %}
    {% if global.features.extensions.tabbed_descriptions %}
        {% set tab_descriptions = [product.description2, product.description3, product.description4, product.description5] %}
    {% endif %}

    {% set tab_title_1 = product.custom_fields.product_tab_1 ? product.custom_fields.product_tab_1 : gts.product_tab_1 %}
    {% set tab_title_2 = product.custom_fields.product_tab_2 ? product.custom_fields.product_tab_2 : gts.product_tab_2 %}
    {% set tab_title_3 = product.custom_fields.product_tab_3 ? product.custom_fields.product_tab_3 : gts.product_tab_3 %}
    {% set tab_title_4 = product.custom_fields.product_tab_4 ? product.custom_fields.product_tab_4 : gts.product_tab_4 %}
    {% set tab_title_5 = product.custom_fields.product_tab_5 ? product.custom_fields.product_tab_5 : gts.product_tab_5 %}

    {% set tab_titles = [tab_title_2, tab_title_3, tab_title_4, tab_title_5] %}

    <section class="product-descriptions">
        <ul class="accordion accordion-description" data-accordion data-multi-expand="true" data-allow-all-closed="true">
            {% for item in tab_descriptions if global.features.extensions.tabbed_descriptions %}
                {% if item|length %}
                    <li class="accordion-item accordion-description-item" data-accordion-item>
                        {# accordian tab tile #}
                        <a href="#" class="accordion-title accordion-description-title" data-name="product_tab_{{ loop.index + 1 }}">{{ tab_titles[loop.index] }}</a>
                        {# accordion tab content #}
                        <div class="accordion-content accordion-description-content" data-tab-content>
                            {{ item|raw }}
                        </div>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </section>
{% endblock %}


{% block product_reviews %}
    <div class="product-reviews row">
        <div class="large-6 column">
            {# Render reviews #}
            {% for review in product.reviews %}
                <div class="customer-review">
                    <div class="review-author">
                        <strong>{{ review.name }}</strong>
                    </div>
                    <div class="review-raiting">
                        {% for i in 1..5 %}
                            {% set starClass = ( review.rating >= i ? 'star-on' : 'star' ) %}
                            <span class="{{ starClass }}" data-review="{{ product.rating }}">
                                {{ theme.sw_icon(starClass, 'raiting star') }}
                            </span>
                        {% endfor %}
                    </div>
                    <div class="review-comment">
                        <p>
                            {{ review.content }}
                        </p>
                    </div>
                </div>
            {% else %}
                <p>Be the first  to review this product.</p>
            {% endfor %}
        </div>
        <div class="large-6 column">
            <h3>Leave a review</h3>
            {# Render review form #}
            {{ theme.form(review_form_fields, false, { 'name': 'Name', 'content': 'Review', 'rating': 'Rating' }) }}
        </div>
    </div>
{% endblock %}


{% block product_recent %}
    {% if global.recently_viewed_products|length %}
        <section class="recent-products section-block inner-section bg-shade">
            <div class="row column">
                <h2 class="recent-products-title section-title">
                    Recently viewed
                </h2>
            </div>
            <div class="products items-container row product-slider" data-slick='{"slidesToShow": 4}'>
                {% for product in global.recently_viewed_products %}
                    <div class="column">
                        <div class="recent-box card item-box item-image">
                            <a class="image-container" href="{{ product.url }}" data-fit="0">
                                <img src="{{ product.photo_url }}" alt="{{ product.photo_description }}">
                            </a>
                            {% if product.in_wishlist %}
                                <a href="/wishlist?action=remove&amp;product_id={{ product.id }}" class="button no-margin secondary wishlist-button">
                                    <span class="show-for-sr">{{ gts.button_remove_from_wishlist }}</span>
                                    <i class="sw-icon-star-on" aria-hidden="true"></i>
                                </a>
                            {% else %}
                                <a href="/wishlist?action=add&amp;product_id={{ product.id }}" class="button no-margin secondary wishlist-button">
                                    <span class="show-for-sr">{{ gts.button_add_to_wishlist }}</span>
                                    <i class="sw-icon-star" aria-hidden="true"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            {{ theme.slider('', '', 0, items|length) }}
        </section>
    {% endif %}
{% endblock %}

{% block product_related %}
    {% if product.related_products|length %}
        <section class="recent-products section-block inner-section bg-shade">
            <div class="row column">
                <h2 id="related-products" class="recent-products-title section-title">
                    Relaterede produkter
                </h2>
            </div>
            <div class="products items-container row product-slider" data-slick='{"slidesToShow": 4}'>
                {% for product in product.related_products %}
                    <div class="column">
                        <div class="recent-box card item-box item-image{{ global.current_path == '/wishlist' ? ' js-wish-list-view' : '' }}">
                            <a class="image-container" href="{{ product.url }}" data-fit="0">
                                <img src="{{ product.photo_url }}" alt="{{ product.photo_description }}">
                            </a>
                            {# render wishlist button #}
                            <a href="/wishlist?action={{ product.in_wishlist ? 'remove' : 'add' }}&amp;product_id={{ product.id }}" class="button no-margin secondary wishlist-button js-wishlist-button {{ product.in_wishlist ? ' on' : '' }}" data-remove="{{ gts.button_remove_from_wishlist }}" data-add="{{ gts.button_add_to_wishlist }}">
                                {% set heart_icon = product.in_wishlist ? 'heart' : 'heart-o' %}
								{% set star_icon = product.in_wishlist ? 'star-on' : 'star' %}
                                <span class="show-for-sr">{{ product.in_wishlist ? gts.button_remove_from_wishlist : gts.button_add_to_wishlist }}</span>
                                {{ theme.sw_icon(star_icon) }}
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {{ theme.slider('', '', 0, items|length) }}
        </section>
    {% endif %}
{% endblock %}

{% block product_bundle %}
    {% if product.bundles|length %}
        <section class="recent-products section-block inner-section bg-shade">
            <div class="row column">
                <h2 class="recent-products-title section-title">
                    Bundles
                </h2>
            </div>
            <div class="products items-container row product-slider" data-slick='{"slidesToShow": 4}'>
                {% for product in product.bundles %}
                    <div class="column">
                        <div class="recent-box card item-box item-image{{ global.current_path == '/wishlist' ? ' js-wish-list-view' : '' }}">
                            <a class="image-container" href="{{ product.url }}" data-fit="0">
                                <img src="{{ product.photo_url }}" alt="{{ product.photo_description }}">
                            </a>
                            {# render wishlist button #}
                            <a href="/wishlist?action={{ product.in_wishlist ? 'remove' : 'add' }}&amp;product_id={{ product.id }}" class="button no-margin secondary wishlist-button js-wishlist-button {{ product.in_wishlist ? ' on' : '' }}" data-remove="{{ gts.button_remove_from_wishlist }}" data-add="{{ gts.button_add_to_wishlist }}">
                                {% set heart_icon = product.in_wishlist ? 'heart' : 'heart-o' %}
                                <span class="show-for-sr">{{ product.in_wishlist ? gts.button_remove_from_wishlist : gts.button_add_to_wishlist }}</span>
                                {{ theme.sw_icon(heart_icon) }}
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {{ theme.slider('', '', 0, items|length) }}
        </section>
    {% endif %}
{% endblock %}

{% block scripts %}
	{{ parent() }}
	{% if product %}
		{% include 'partials/product_data.twig' %}
	{% endif %}
{% endblock %}
