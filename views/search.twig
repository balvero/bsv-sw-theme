{# Extend collection template #}
{% extends 'templates/collection.twig' %}

{% set gts = global.theme.settings %}
{% set title = 'Søge resultat' %}
{% set contentClass = 'bg-shade' %}
{% set algoliaSearch = gts.text_algolia_app_id and gts.text_algolia_api_key ? true : false %}

{% set filter_product_count = 0 %}
{% for filter_group in filter_groups %}
    {% for filter in filter_group.filters %}
        {% set filter_product_count = filter_product_count + filter.product_count %}
    {% endfor %}
{% endfor %}

{% set show_sidebar = filter_product_count ? true : false %}
{% set grid_classes = filter_product_count ? '' : ' large-up-4' %}

{% block sidebar %}
    {# Render category menu #}
    {% include 'partials/category_menu.twig' with { hide_side_menu: true } %}
{% endblock %}

{% block items %}
	{% if algoliaSearch %}
		{# Algolia-powered search results #}
		{% include 'partials/items.twig' with { 'item_type': 'algolia', 'initial_query': keywords|default('') } %}
	{% else %}
		{# Render products #}
		{% include 'partials/items.twig' with { 'classes': 'small-up-2 medium-up-3' ~  grid_classes } %}
	{% endif %}
{% endblock %}
