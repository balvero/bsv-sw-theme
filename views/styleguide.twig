{# Extend page template #}
{% extends 'templates/page.twig' %}

{% set title = 'Style Guide' %}
{% set hideTitle = 0 %}
{% set hideTitleBar = 0 %}
{% set side_list = 0 %}
{% set full_width = 1 %}
{% set bodyClass = 'sg-page' %}

{% block page_content %}
    <div class="row page-container" data-equalizer data-equalize-on="medium">
        <div class="{{ side_list and side_list.links ? 'large-9 large-push-3' : 'small-12' }} column" data-equalizer-watch>
            <div class="page__inner">
                <a class="sg-collapse-all">Collapse all</a>
                {# varaibles #}
                <section class="sg-section">
                    <h2>
                        <span>Variables</span>
                    </h2>
                    <ul class="accordion" data-accordion data-allow-all-closed="true" data-multi-expand="true">

                        {% set colour_count = 0 %}
                        {% for key, value in gts %}
                            {% if 'color_' in key %}
                                {% set colour_count = colour_count + 1 %}
                            {% endif %}
                        {% endfor %}

                        {# colour settings / SCSS variables #}
                        {% if colour_count %}
                            <li class="accordion-item is-active" data-accordion-item>
                                <a href="#" class="accordion-title">
                                    Colours
                                </a>
                                <div class="accordion-content" data-tab-content>
                                    <div class="row small-up-2 medium-up-3 large-up-4">
                                        {% for key, value in gts %}
                                            {% if 'color_' in key %}
                                                <div class="column">
                                                    <div class="sg-colour card">
                                                        <div class="card-divider sg-swatch" style="background: {{ value }}"></div>
                                                        <div class="card-section sg-colour__title">
                                                            <dl>
                                                                <dt>
                                                                    SCSS variable
                                                                    <a class="sg-copy" data-copy="scss-{{ loop.index }}" title="copy ${{ key }}">
                                                                        {{ theme.sw_icon('copy') }}
                                                                    </a>
                                                                </dt>
                                                                <dd>
                                                                    <code id="scss-{{ loop.index }}">${{ key }}</code>
                                                                </dd>
                                                                <dt>
                                                                    Hexidecimal value
                                                                    <a class="sg-copy" data-copy="hex-{{ loop.index }}" title="copy {{ value }}">
                                                                        {{ theme.sw_icon('copy') }}
                                                                    </a>
                                                                </dt>
                                                                <dd>
                                                                    <code id="hex-{{ loop.index }}">{{ value }}</code>
                                                                </dd>
                                                            </dl>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </li>
                        {% endif %}
                        {# CSS breakpoints #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Responsive Breakpoints
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <p>
                                    We use six major breakpoints in SCSS based on Zurb Foundation:
                                </p>
                                <ul>
                                    <li>
                                        <code>$s-only</code> for small screens
                                    </li>
                                    <li>
                                        <code>$m-up</code> for medium and above
                                    </li>
                                    <li>
                                        <code>$m-down</code> for medium and below
                                    </li>
                                    <li>
                                        <code>$m-only</code> for medium only
                                    </li>
                                    <li>
                                        <code>$l-up</code> for large and above
                                    </li>
                                    <li>
                                        <code>$l-only</code> for large only
                                    </li>
                                </ul>
                                <table>
                                    <tr>
                                        <th></th>
                                        <th>Small</th>
                                        <th>Medium</th>
                                        <th>Large</th>
                                    </tr>
                                    <tr>
                                        <td>REMs</td>
                                        <td>40</td>
                                        <td>64</td>
                                        <td>75</td>
                                    </tr>
                                    <tr>
                                        <td>Pixels</td>
                                        <td>640</td>
                                        <td>1024</td>
                                        <td>1200</td>
                                    </tr>
                                </table>
                                <p>
                                    Usage:
                                </p>
<pre>
// Applies to screens wider than the "large" breakpoint of 1200px
@media #{$l-up} {
    .foo {
        width: 100%;
    }
}
</pre>
                            </div>
                        </li>
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Theme Colours
                            </a>
                            {% set theme_colours = {
                                'black': '000000',
                                'white': 'ffffff',
                                'light grey': 'dddddd',
                                'tangerine': 'f58900',
                                'casablanca': 'f9c348',
                                'mineshaft': '333333',
                                'grey': '818181',
                                'silver': 'c9c9c9',
                                'alto': 'e0e0e0',
                                'gallery': 'eaeaea',
                                'danger': 'c93832',
                                'porcelain': 'f1f3f4'
                            } %}
                            <div class="accordion-content" data-tab-content>
                                <div class="row small-up-2 medium-up-3 large-up-4">
                                    {% for key, value in theme_colours %}
                                        <div class="column">
                                            <div class="card sg-colour">
                                                <div class="card-divider sg-swatch" style="background: #{{ value }}"></div>
                                                <div class="card-section sg-colour__title">
                                                    <dl>
                                                        <dt>
                                                            Colour
                                                        </dt>
                                                        <dd>
                                                            <span>{{ key }}</span>
                                                        </dd>
                                                        <dt>
                                                            Hexidecimal value
                                                            <a class="sg-copy" data-copy="hex-colour-{{ loop.index }}" title="copy #{{ value }}">
                                                                {{ theme.sw_icon('copy') }}
                                                            </a>
                                                        </dt>
                                                        <dd>
                                                            <code id="hex-colour-{{ loop.index }}">#{{ value }}</code>
                                                        </dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </li>
                    </ul>
                </section>

                {#section note #}
                <section class="sg-section">
                    <h2>
                        <span>Typography</span>
                    </h2>
                    <ul class="accordion" data-accordion data-allow-all-closed="true" data-multi-expand="true">
                        {# Headers #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Headers
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <h1>h1. This is a very large header.</h1>
                                <h2>h2. This is a large header.</h2>
                                <h3>h3. This is a medium header.</h3>
                                <h4>h4. This is a moderate header.</h4>
                                <h5>h5. This is a small header.</h5>
                                <h6>h6. This is a tiny header.</h6>

                                <h1 class="page-title">Page title</h1>

                                <h2 class="section-title">Section title</h2>
                            </div>
                        </li>
                        {# Subheaders #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Subheaders
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <h1 class="subheader">h1.subheader</h1>
                                <h2 class="subheader">h2.subheader</h2>
                                <h3 class="subheader">h3.subheader</h3>
                                <h4 class="subheader">h4.subheader</h4>
                                <h5 class="subheader">h5.subheader</h5>
                                <h6 class="subheader">h6.subheader</h6>
                            </div>
                        </li>
                        {# Paragraphs #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Paragraphs
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <p>
                                    This is a paragraph. Paragraphs are preset with a font size, line height and spacing to match the overall vertical
                                    rhythm. To show what a paragraph looks like this needs a little more content so, did you know that there are storms
                                    occurring on Jupiter that are larger than the Earth? Pretty cool. Wrap strong around type to <strong>make it bold!
                                    </strong>. You can also use em to <em>italicize your words</em>.
                                </p>
                            </div>
                        </li>
                        {# Links #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Links
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, <a href="#">sed do eiusmod tempor incididunt</a> ut labore et
                                    dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip
                                    ex ea commodo consequat.Learn more about Foundation's global colors.
                                </p>
                            </div>
                        </li>
                        {# Dividers #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Dividers
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <hr>
                            </div>
                        </li>
                        {# icon font #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Icon Font
                            </a>
                            <div class="accordion-content" data-tab-content>
                                <p>
                                    Use the icon font for single color iconography.
                                </p>
                                {# icon definitions #}
                                {% set myIcons = [
                                    'star1',
                                    'star-empty',
                                    'speech',
                                    'cross',
                                    'full-screen',
                                    'glass1',
                                    'mail1',
                                    'monitor',
                                    'pencil',
                                    'phone1',
                                    'speech--alt',
                                    'square--small',
                                    'toggle-arrows',
                                    'arrow',
                                    'commerce',
                                    'filter',
                                    'basket',
                                    'update',
                                    'log-out',
                                    'account-home',
                                    'box',
                                    'eye',
                                    'forbidden',
                                    'glass',
                                    'calendar',
                                    'facebook',
                                    'gift',
                                    'refresh',
                                    'pdf',
                                    'map-marker',
                                    'twitter',
                                    'google-plus',
                                    'linkedin',
                                    'pinterest',
                                    'youtube',
                                    'instagram',
                                    'bell',
                                    'heart',
                                    'heart-o',
                                    'bars',
                                    'glass-2',
                                    'caret-down',
                                    'caret-up',
                                    'star',
                                    'star-on',
                                    'external-link',
                                    'plus-zoom',
                                    'play',
                                    'copy',
                                    'grid',
                                    'list',
                                    'caret-right',
                                    'circle-star',
                                    'gift1',
                                    'mail',
                                    'send',
                                    'map',
                                    'padlock',
                                    'phone',
                                    'shopping-bag',
                                    'truck',
                                    'down-arrow',
                                    'down-chevron',
                                    'left-arrow',
                                    'left-chevron',
                                    'move',
                                    'question',
                                    'right-arrow',
                                    'right-chevron',
                                    'search',
                                    'up-arrow',
                                    'up-chevron',
                                    'minus',
                                    'plus'
                                ] %}
                                <div class="row small-up-1 medium-up-2 large-up-3">
                                    {% for item in myIcons %}
                                        <div class="column">
                                            <div class="sg-icons" style="margin-bottom: 1rem;">
                                                <h5>{{ item }}</h5>
                                                <i class="sw-icon-{{ item }}" aria-hidden="true" style="font-size: 3rem;"></i>
                                                <i class="sw-icon-{{ item }}" aria-hidden="true" style="font-size: 2rem;"></i>
                                                <i class="sw-icon-{{ item }}" aria-hidden="true" style="font-size: 1.5rem;"></i>
                                                <i class="sw-icon-{{ item }}" aria-hidden="true" style="font-size: 1rem;"></i>
                                                <i class="sw-icon-{{ item }}" aria-hidden="true" style="font-size: .7rem;"></i>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <hr>
                                <p>
                                    Usage:
                                </p>
<pre>
   &lt;i class="sw-icon-[name]" aria-hidden="true"&gt;
</pre>
                            </div>
                        </li>
                    </ul>
                </section>

                {# buttons #}
                <section class="sg-section">
                    <h2>
                        <span>Controls</span>
                    </h2>
                    <ul class="accordion" data-accordion data-allow-all-closed="true" data-multi-expand="true">
                        {# Buttons #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Buttons
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# colouring #}
                                <h3>Colouring</h3>

                                <a class="button primary" href="#">Primary</a>
                                <a class="button secondary" href="#">Secondary</a>
                                <a class="button tertiary" href="#">Tertiary</a>
                                <a class="button success" href="#">Success</a>
                                <a class="button alert" href="#">Alert</a>
                                <a class="button warning" href="#">Warning</a>

                                <h3>Sizing</h3>

                                <a class="button tiny" href="#">Tiny button</a>
                                <a class="button small" href="#">Small button</a>
                                <a class="button" href="#">Basic button</a>
                                <a class="button large" href="#">Large button</a>
                                <div>
                                    <a class="button expanded" href="#">Expanded button</a>
                                </div>
                                <div>
                                    <a class="button small expanded" href="#">Small expand button</a>
                                </div>

                                <h3>Weights</h3>
                                <a class="button primary light" href="#">light</a>
                                <a class="button primary" href="#">Normal</a>
                                <a class="button primary heavy" href="#">Heavy</a>

                                <h3>Padded</h3>
                                <a class="button primary padded-x padded-y" href="#">Padded XY</a>
                                <a class="button primary padded-x" href="#">Padded X</a>
                                <a class="button primary padded-y" href="#">Padded Y</a>

                                <h3>Disabled</h3>

                                <button class="button disabled">Button disabled</button>
                                <a class="button disabled" href="javascript:void(0)">Link disabled</a>
                                <button class="button secondary disabled">Button disabled</button>
                                <a class="button secondary disabled" href="javascript:void(0)">Link disabled</a>

                                <h3>Paypal</h3>
                                <button type="submit" name="paypal_gateway" value="1" class="image-button paypal-button">
                                    <span class="show-for-sr">Checkout with PayPal</span>
                                    <img src="https://www.paypalobjects.com/webstatic/en_US/i/btn/png/gold-rect-paypalcheckout-60px.png" alt="Check out with PayPal" width="170">
                                </button>
                            </div>
                        </li>
                    </ul>
                </section>

                {# Forms #}
                <section class="sg-section">
                    <h2>
                        <span>Forms</span>
                    </h2>
                    <ul class="accordion" data-accordion data-allow-all-closed="true" data-multi-expand="true">
                        {# sub note #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Form components
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# form components #}
                                <div class="row">
                                    <div class="medium-6 column">
                                        {# text input #}
                                        <label class="field-block">
                                            <span class="field-label">
                                                Input Label
                                            </span>
                                            <input type="text" placeholder="text input">
                                        </label>
                                        {# textarea #}
                                        <label class="field-block">
                                            <span class="field-label">
                                                Textarea input
                                            </span>
                                            <textarea placeholder="Textarea"></textarea>
                                        </label>
                                        {# select #}
                                        <label class="field-block">
                                            <span class="field-label">
                                                Select Menu
                                            </span>
                                            <select>
                                                <option value="foo">Foo</option>
                                                <option value="bar">Bar</option>
                                                <option value="baz">Baz</option>
                                            </select>
                                        </label>
                                        {# file input #}
                                        <label class="field-label">Please upload your files</label>
                                        <input type="file" name="files[]">
                                        <br>
                                        {# radio buttons #}
                                        <fieldset class="row column">
                                            <legend class="field-label">Radio buttons</legend>
                                            <input type="radio" name="foo" value="Red" id="fooRed" required><label for="fooRed">Red</label>
                                            <input type="radio" name="foo" value="Blue" id="fooBlue"><label for="fooBlue">Blue</label>
                                            <input type="radio" name="foo" value="Yellow" id="fooYellow"><label for="fooYellow">Yellow</label>
                                        </fieldset>
                                        {# checkboxes #}
                                        <fieldset class="row column">
                                            <legend class="field-label">Checkboxes</legend>
                                            <input id="checkbox1" type="checkbox"><label for="checkbox1">Checkbox 1</label>
                                            <input id="checkbox2" type="checkbox"><label for="checkbox2">Checkbox 2</label>
                                            <input id="checkbox3" type="checkbox"><label for="checkbox3">Checkbox 3</label>
                                        </fieldset>
                                        {# mod checkboxes #}
                                        <fieldset class="row column">
                                            <legend class="field-label">Mod Checkboxes</legend>
                                            <input id="checkboxM1" type="checkbox" class="mod"><label for="checkboxM1">Checkbox 1</label>
                                            <input id="checkboxM2" type="checkbox" class="mod"><label for="checkboxM2">Checkbox 2</label>
                                            <input id="checkboxM3" type="checkbox" class="mod"><label for="checkboxM3">Checkbox 3</label>
                                        </fieldset>
                                        {# input group #}
                                        <div class="input-group">
                                            <span class="input-group-label">Label</span>
                                            <input class="input-group-field" type="text" placeholder="Input group">
                                            <div class="input-group-button">
                                                <button type="submit" class="button">Button</button>
                                            </div>
                                        </div>
                                        {# date field #}
                                        <div class="_delivery-date-container">
                                            <label for="delivery_date">Select a preferred date</label>
                                            <input type="text" name="delivery_date" class="hasDatepicker">
                                        </div>
                                        {# validation error message #}
                                        <label class="field-block">
                                            <span class="field-label">Email address</span>
                                            <span id="email-error" class="validation-error">Please enter a valid email address.</span>
                                            <input type="email" name="email" value="foo" class="required validation-error" aria-required="true" aria-describedby="email-error" aria-invalid="true">
                                        </label>
                                    </div>
                                </div>

                                {# /form components #}
                            </div>
                        </li>
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Contact Form
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# contact form #}
                                <div class="row">
                                    <div class="column medium-8">
                                        <form action="{{ global.current_url }}" method="post" class="form-with-validation">
                                            <label class="field-block">
                                                <span class="field-label">Full Name</span>
                                                {{ html.input('name', form_field_value('name'), 'form-control required') }}
                                            </label>

                                            <label class="field-block">
                                                <span class="field-label">Email Address</span>
                                                {{ html.input('email', form_field_value('email'), 'form-control required') }}
                                            </label>

                                            <label class="field-block">
                                                <span class="field-label">Telephone No</span>
                                                {{ html.input('phone', form_field_value('phone'), 'form-control') }}
                                            </label>

                                            <label class="field-block">
                                                <span class="field-label">Your Enquiry</span>
                                                {{ html.textarea('message', form_field_value('message'), 'form-control required', '') }}
                                            </label>
                                            <div class="row column">
                                                {{ shopwired.honeypot() }}
                                                <button type="submit" class="button">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                {# / contact form #}
                            </div>
                        </li>
                    </ul>
                </section>

                {# components #}
                <section class="sg-section">
                    <h2>
                        <span>Components</span>
                    </h2>
                    <ul class="accordion" data-accordion data-allow-all-closed="true" data-multi-expand="true">
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Announcement Bar
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# announcment bar #}
                                <div class="announcement-bar callout no-margin" data-closable>
                                    <div class="row column">
                                        <div class="inner text-center">
                                            <span>{{ theme.text_snippet('announce') }}</span>
                                        </div>
                                    </div>
                                    <button class="announcement-bar-close close-button" aria-label="Dismiss alert" type="button" data-close>
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                {# / announcment bar #}
                            </div>
                        </li>
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Homepage banner carousel
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# homepage banner carousel #}

                                {% set fullWidth = 1 %}
                                {% set home_galleries = {
                                    'large': gts.gallery_home,
                                    'small': gts.gallery_home_mobile
                                } %}

                                {# Render carousel #}
                                {% for size, gallery in home_galleries %}
                                    {% if gallery %}
                                        <div class="home-carousel-outer home-carousel{{ size == 'small' ? '-mobile hide-for-medium' : '-desktop show-for-medium' }}">
                                            <div id="js-home-carousel{{ size == 'small' ? '-mobile' : '' }}"
                                                 class="carousel home-carousel {{ fullWidth ? '' : 'row column' }}"
                                                 data-autoplay="{{ gts.gallery_autoplay ? true : false }}"
                                                 data-speed="{{ gts.gallery_autoplaySpeed * 1000 }}"
                                                 style="margin-top:0;"
                                            >
                                                {% for image in gallery %}
                                                    <div class="home-carousel-slide">
                                                        {% if image.target_url %}
                                                            <a href="{{ image.target_url }}">
                                                                <img src="{{ image.url('large') }}" alt="{{ image.name }}" class="full-width">
                                                            </a>
                                                        {% else %}
                                                            <img src="{{ image.url('large') }}" alt="{{ image.name }}" class="full-width">
                                                        {% endif %}
                                                        {% if image.name %}
                                                            <div class="home-carousel-overlay{{ size == 'small' ? '-mobile' : '' }}">
                                                                {{ image.name|raw }}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                                {# / homepage banner carousel #}
                            </div>
                        </li>
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Star raiting
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# star raiting #}
                                <span class="review-raiting">
                                    {% for i in 1..5 %}
                                        {% set starClass = ( 3 >= i ? 'on' : 'off' ) %}
                                        <span class="{{ starClass }}">
                                            {{ theme.sw_icon('heart-o', 'raiting heart') }}
                                        </span>
                                    {% endfor %}
                                </span>
                                {# / star raiting #}
                            </div>
                        </li>
                        {# sub note #}
                        <li class="accordion-item is-active" data-accordion-item>
                            <a href="#" class="accordion-title">
                                Product labels
                            </a>
                            <div class="accordion-content" data-tab-content>
                                {# product labels #}
                                <span class="label primary two-for-one">2 for 1</span>
                                <br>
                                <span class="label primary three-for-two">3 for 2</span>
                                <br>
                                <span class="label secondary new">New</span>
                                {# / product labels #}
                            </div>
                        </li>
